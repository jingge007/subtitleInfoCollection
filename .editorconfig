# subtitleInfoCollection EditorConfig
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{ps1,psm1}]
indent_style = space
indent_size = 4

[*.{md,mdc}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{toml,yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf
