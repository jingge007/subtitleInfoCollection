# TMDb Bearer Token，用于采集 TMDb Top 电影。
TMDB_TOKEN=

# ASSRT API 令牌，填写后启用 ASSRT 字幕源。
ASSRT_TOKEN=
ASSRT_API_BASE_URL=https://api.assrt.net/v1

# OpenSubtitles REST API。搜索需要 API 密钥，下载需要用户名和密码。
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_BASE_URL=https://api.opensubtitles.com/api/v1
OPENSUBTITLES_USER_AGENT=subtitleInfoCollection v0.1

# 字幕源行为配置。
SUBTITLE_PROVIDER_PRIORITY=subhd,assrt,opensubtitles
SUBTITLE_PROVIDER_DISABLED=
SUBTITLE_REQUEST_INTERVAL_MS=13000

# 打包产物输出目录。仅影响 scripts/build_windows.ps1 或 字幕采集工具.spec 打包后的程序目录，不影响字幕、JSON、数据库等运行数据输出。
# 留空时默认输出到 项目目录/dist/字幕采集工具。
# 推荐填写最终目录，例如 D:\软件\字幕采集工具；如果填写父级目录，例如 D:\软件，则最终输出为 D:\软件\字幕采集工具。
# 相对路径按项目根目录解析，例如 release_dist\字幕采集工具。
SUBTITLE_COLLECTION_PACKAGE_DIST_DIR=

# 数据目录。留空时默认使用 %USERPROFILE%/subtitleInfoCollection。
SUBTITLE_COLLECTION_DATA_DIR=

# 可选 HTTP 代理，例如 http://127.0.0.1:7890
HTTP_PROXY=
HTTPS_PROXY=
