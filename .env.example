# 配置文件位置：源码运行读取仓库根目录 .env；打包版读取 %APPDATA%\subtitleInfoCollection\.env。
# 本文件只提供模板，禁止把真实 Token/密码写入并提交；.env 已在 .gitignore 中忽略。

# TMDB_TOKEN：TMDb Bearer Token，用于采集指定年份的 TMDb 电影榜单，也用于本地字幕解析时匹配电影信息；留空会导致电影榜单采集不可用。
TMDB_TOKEN=

# ASSRT_TOKEN：ASSRT 字幕源 API 令牌；填写后启用 ASSRT 搜索和下载，留空时 ASSRT 会被判定为未配置。
ASSRT_TOKEN=

# ASSRT_API_BASE_URL：ASSRT API 基础地址；默认 https://api.assrt.net/v1。
# 仅在网页搜索失败时作搜索兜底；主域不通可改为 https://api.makedie.me/v1。
# 程序会自动 failover：备用域 HTTPS → HTTP（备用域优先）；HTTPS 证书主机名不匹配会快切；
# HTTP 5xx（如 503）会继续试下一候选。当前环境下 http://api.makedie.me/v1 常为 API 可用兜底。
ASSRT_API_BASE_URL=https://api.assrt.net/v1

# ASSRT_SITE_BASE_URL：ASSRT 网页站点基础地址；默认 https://2.assrt.net。
# 搜索与下载主路径走站点：/sub/?searchword=… → 详情页「下载字幕」；不通时可改 https://assrt.net。
ASSRT_SITE_BASE_URL=https://2.assrt.net

# SUBDL_API_KEY：SubDL 官方 API 密钥；填写后启用 SubDL 字幕源，留空时 SubDL 会被判定为未配置。
SUBDL_API_KEY=

# SUBDL_BASE_URL：SubDL 搜索接口基础地址；通常保持默认值，只有接口地址变更或使用代理网关时才需要修改。
SUBDL_BASE_URL=https://api.subdl.com/api/v1

# SUBDL_DOWNLOAD_BASE_URL：SubDL 下载文件基础地址；通常保持默认值，用于拼接 SubDL 返回的相对下载路径。
SUBDL_DOWNLOAD_BASE_URL=https://dl.subdl.com

# SUBDL_LANGUAGES：SubDL 搜索语言范围，多个语言用英文逗号分隔；默认 ZH 以减少纯英候选空转，最终仍以后续中英双语内容校验为准。
SUBDL_LANGUAGES=ZH

# SUBDL_INCLUDE_TRADITIONAL：是否允许 SubDL 搜索繁体中文字幕；默认 false 表示不主动包含繁体，true 表示搜索时允许繁体候选进入后续校验。
SUBDL_INCLUDE_TRADITIONAL=false

# OPENSUBTITLES_API_KEY：OpenSubtitles REST API 密钥；用于字幕搜索，留空时 OpenSubtitles 会被判定为未配置。
OPENSUBTITLES_API_KEY=

# OPENSUBTITLES_USERNAME：OpenSubtitles 用户名；下载字幕时需要和密码一起使用。
OPENSUBTITLES_USERNAME=

# OPENSUBTITLES_PASSWORD：OpenSubtitles 密码；下载字幕时需要和用户名一起使用。
OPENSUBTITLES_PASSWORD=

# OPENSUBTITLES_BASE_URL：OpenSubtitles REST API 基础地址；通常保持默认值，只有官方地址变更或使用代理网关时才需要修改。
OPENSUBTITLES_BASE_URL=https://api.opensubtitles.com/api/v1

# OPENSUBTITLES_USER_AGENT：OpenSubtitles 请求使用的 User-Agent；建议保持包含应用名称和版本，部分接口会校验该字段。
OPENSUBTITLES_USER_AGENT=subtitleInfoCollection v0.2.3

# TODAYS_LINES_USERNAME：33 台词自动化脚本登录账号；只在执行“自动化脚本”功能时使用。
TODAYS_LINES_USERNAME=

# TODAYS_LINES_PASSWORD：33 台词自动化脚本登录密码；只在执行“自动化脚本”功能且本地 token 不可用时使用。
TODAYS_LINES_PASSWORD=

# TODAYS_LINES_TOKEN：33 台词登录成功后缓存的访问 token；通常由程序自动写入，手动留空即可。
TODAYS_LINES_TOKEN=

# TODAYS_LINES_TOKEN_TIME：33 台词 token 缓存时间戳；通常由程序自动写入，用于判断 token 是否需要刷新。
TODAYS_LINES_TOKEN_TIME=

# BAIDU_TRANSLATE_APP_ID：百度翻译开放平台应用 ID；用于自动化脚本补全英文字幕，留空则跳过英文补全翻译。
BAIDU_TRANSLATE_APP_ID=

# BAIDU_TRANSLATE_SECRET：百度翻译开放平台密钥；需要和 BAIDU_TRANSLATE_APP_ID 配套使用。
BAIDU_TRANSLATE_SECRET=

# SUBTITLE_PROVIDER_PRIORITY：字幕源启用列表与搜索优先级，多个字幕源用英文逗号分隔；支持 subhd、assrt、opensubtitles、subdl，越靠前越优先搜索。
# 仅出现在此列表中的源会显示在采集页「字幕源」勾选框；未列出的源会隐藏且不参与采集。
SUBTITLE_PROVIDER_PRIORITY=subhd,assrt,opensubtitles,subdl

# SUBTITLE_PROVIDER_DISABLED：需要禁用的字幕源，多个字幕源用英文逗号分隔；留空表示不额外禁用，例如 opensubtitles 表示跳过 OpenSubtitles。
SUBTITLE_PROVIDER_DISABLED=

# SUBTITLE_REQUEST_INTERVAL_MS：字幕源请求间隔，单位毫秒；程序会把过低数值自动限制到安全下限（当前不低于 8000）。遇到 429 限流时短退避后仍失败会本轮熔断该源；连续网络不可达仅在同一部电影内跳过该源，下一部电影会重新尝试。
SUBTITLE_REQUEST_INTERVAL_MS=8000

# SUBTITLE_MOVIE_CONCURRENCY：同时处理的电影数量；默认 2 表示有限并发采集，1 表示与旧版相同的串行行为；有效范围 1～4。
SUBTITLE_MOVIE_CONCURRENCY=2

# SUBTITLE_MIN_BILINGUAL_RATIO：下载后字幕内容双语条目的最低占比，取值范围 0.0 到 1.0；0.70 表示至少 70% 有效字幕条目必须同时包含简体中文和英文。
SUBTITLE_MIN_BILINGUAL_RATIO=0.70

# SUBHD_CAPTCHA_OCR_ENABLED：是否启用 SubHD 验证码辅助识别；true 表示尝试自动识别验证码，false 表示需要人工输入。
SUBHD_CAPTCHA_OCR_ENABLED=true

# SUBHD_CAPTCHA_AUTO_SUBMIT_MIN_CONFIDENCE：SubHD 验证码自动提交的最低置信度，取值范围 0.0 到 1.0；识别置信度低于该值时会等待人工确认。
SUBHD_CAPTCHA_AUTO_SUBMIT_MIN_CONFIDENCE=0.85

# SUBHD_CAPTCHA_OCR_MAX_ATTEMPTS：SubHD 验证码 OCR 最大尝试次数（预处理配置 × PSM 模式 × 白名单组合）；默认自动根据组合数计算，设置后可限制最大尝试次数以控制耗时。
# 留空使用默认值（自动计算，通常 30-50 次组合尝试）。
SUBHD_CAPTCHA_OCR_MAX_ATTEMPTS=

# SUBHD_SEARCH_TIMEOUT：SubHD 单个字幕源搜索超时，单位秒；由于 SubHD 需要浏览器模拟或多次重试，建议不低于 60 秒；留空使用默认值 120。
SUBHD_SEARCH_TIMEOUT=120

# PROVIDER_SEARCH_TIMEOUT：非 SubHD 字幕源（SubDL、ASSRT、OpenSubtitles）单个搜索超时，单位秒；这些源走 REST API 响应较快，留空使用默认值 90。
PROVIDER_SEARCH_TIMEOUT=90

# SUBHD_DOWNLOAD_TIMEOUT：SubHD 单次下载硬超时，单位秒；超时后停止多域名/Playwright 尝试并换候选或换源；留空使用默认值 180。
SUBHD_DOWNLOAD_TIMEOUT=180

# PROVIDER_DOWNLOAD_TIMEOUT：非 SubHD 字幕源单次下载硬超时，单位秒；留空使用默认值 60。
PROVIDER_DOWNLOAD_TIMEOUT=60

# CAPTCHA_SOUND_ENABLED：验证码弹出时是否播放系统提示音；true 播放提示音，false 静默。
CAPTCHA_SOUND_ENABLED=true

# SUBTITLE_COLLECTION_PACKAGE_DIST_DIR：Windows 打包产物输出目录；只影响 scripts/build_windows.ps1 的程序打包目录，不影响字幕、JSON、数据库等运行数据输出。
# 留空时默认输出到 项目目录/dist/字幕采集工具。
# 推荐填写最终目录，例如 D:\软件\字幕采集工具；如果填写父级目录，例如 D:\软件，则最终输出为 D:\软件\字幕采集工具。
# Velopack 发布资产输出到该目录同级的 releases 子目录。
# 相对路径按项目根目录解析，例如 release_dist\字幕采集工具。
SUBTITLE_COLLECTION_PACKAGE_DIST_DIR=

# SUBTITLE_COLLECTION_DATA_DIR：运行数据目录；用于保存字幕输出、解析结果和本地数据库，留空时默认使用当前用户目录下的 subtitleInfoCollection 文件夹。
SUBTITLE_COLLECTION_DATA_DIR=

# HTTP_PROXY：HTTP 请求代理地址；网络无法直连字幕源或 TMDb 时可填写，例如 http://127.0.0.1:7890，留空表示不使用 HTTP 代理。
HTTP_PROXY=

# HTTPS_PROXY：HTTPS 请求代理地址；网络无法直连字幕源或 TMDb 时可填写，例如 http://127.0.0.1:7890，留空表示不使用 HTTPS 代理。
HTTPS_PROXY=

# 首次准备：python -m pip install -e "backend[dev]"；cd frontend; npm ci。
# 开发运行：.\scripts\run_dev.ps1。
# Windows 打包：.\scripts\build_windows.ps1；生成 Velopack 资产用 .\scripts\build_windows.ps1 -Pack。
